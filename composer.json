{
    "name": "timkelty/http-message-signatures",
    "description": "PSR-7 compliant PHP 8.1+ implementation of HTTP Message Signatures (RFC 9421)",
    "type": "library",
    "keywords": ["http", "signature", "rfc9421", "security", "authentication"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "bakame/http-structured-fields": "^2.0",
        "league/uri-polyfill": "^7.6",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.13",
        "guzzlehttp/psr7": "^2.0",
        "http-interop/http-factory-guzzle": "^1.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "HttpMessageSignatures\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HttpMessageSignatures\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --configuration phpunit.xml",
        "test-coverage": "vendor/bin/phpunit --configuration phpunit.xml --coverage-text",
        "fmt": "vendor/bin/mago fmt",
        "lint": "vendor/bin/mago lint --potentially-unsafe --minimum-fail-level=error",
        "lint:fix": "vendor/bin/mago lint --fix --format-after-fix",
        "style": [
            "@fmt",
            "@lint:fix"
        ],
        "phpstan": "phpstan analyse",
        "analyse": [
            "@lint",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "carthage-software/mago": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
